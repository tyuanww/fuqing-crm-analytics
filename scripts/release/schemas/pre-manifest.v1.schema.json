{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_tag",
    "product_version",
    "source_sha",
    "dsh_upstream_sha",
    "artifacts",
    "archive_allowlist",
    "denylist_version"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "pre-manifest/v1"
      ]
    },
    "release_tag": {
      "type": "string",
      "pattern": "^dsh-[A-Za-z0-9._-]+$"
    },
    "product_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dsh_upstream_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "path"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "archive_allowlist": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "denylist_version": {
      "type": "string",
      "enum": [
        "release-denylist/v1"
      ]
    }
  }
}
