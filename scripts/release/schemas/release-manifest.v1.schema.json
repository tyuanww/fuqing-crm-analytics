{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_tag",
    "product_version",
    "source_sha",
    "dsh_upstream_sha",
    "payload",
    "archive_allowlist",
    "denylist_version",
    "artifact_bytes",
    "artifact_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "release-manifest/v1"
      ]
    },
    "release_tag": {
      "type": "string",
      "pattern": "^dsh-[A-Za-z0-9._-]+$"
    },
    "product_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dsh_upstream_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pre_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "archive_allowlist": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "denylist_version": {
      "type": "string",
      "enum": [
        "release-denylist/v1"
      ]
    },
    "build_time": {
      "type": "string"
    },
    "retention_until": {
      "type": "string"
    },
    "toolchain": {
      "type": "object"
    },
    "payload": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "artifact_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
