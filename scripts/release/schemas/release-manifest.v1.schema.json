{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_tag",
    "product_version",
    "source_sha",
    "dsh_upstream_sha",
    "payload",
    "archive_allowlist",
    "denylist_version",
    "artifact_bytes",
    "artifact_sha256"
  ],
  "properties": {
    "profile_pack_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "enum": ["shinemage-release-pack-inputs.json"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "profile_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "service_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "binding", "evidence_json", "status", "release_ready", "activation"],
      "properties": {
        "schema_version": { "type": "string", "enum": ["dsh-service-compatibility-gate/v1"] },
        "binding": { "type": "object" },
        "evidence_json": { "type": "string" },
        "status": { "type": "string", "enum": ["LOCAL_COMPATIBLE"] },
        "release_ready": { "type": "boolean", "enum": [false] },
        "activation": { "type": "string", "enum": ["BLOCKED_SERVICE_PACKAGE_AND_HOST_EVIDENCE_REQUIRED"] }
      }
    },
    "schema_version": {
      "type": "string",
      "enum": [
        "release-manifest/v1"
      ]
    },
    "release_tag": {
      "type": "string",
      "pattern": "^dsh-[A-Za-z0-9._-]+$"
    },
    "product_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dsh_upstream_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pre_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "archive_allowlist": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "denylist_version": {
      "type": "string",
      "enum": [
        "release-denylist/v1"
      ]
    },
    "build_time": {
      "type": "string"
    },
    "retention_until": {
      "type": "string"
    },
    "toolchain": {
      "type": "object"
    },
    "payload": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "artifact_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "upstream_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "upstream_sha",
        "bytes",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "const": "upstream-runtime-bundle"
        },
        "upstream_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
