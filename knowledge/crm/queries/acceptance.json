      "forbidden_claims": [
        "已按真实库扣退款",
        "字段已核验"
      ],
      "source": "knowledge-graph-design.md 最小试点验收"
    },
    {
      "id": "q.new_member_conversion",
      "question": "能算新会员转化吗？",
