{
  "name": "frontend-vue3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "gen:types": "openapi-typescript $API_URL -o src/api/types.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint:spec": "bash e2e/lint/spec-lint-l2.sh e2e"
  },
  "dependencies": {
    "@rive-app/canvas": "^2.42.2",
    "@tanstack/vue-query": "^5.103.1",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^15.0.0",
    "axios": "1.18.1",
    "echarts": "6.1.0",
    "naive-ui": "^2.45.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.32",
    "vue-echarts": "^8.3.0",
    "vue-router": "^5.3.1",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/ui": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
