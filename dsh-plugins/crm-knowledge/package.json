{
  "name": "@shine-mage/dsh-crm-knowledge",
  "version": "0.0.0-candidate",
  "private": true,
  "type": "module",
  "description": "Isolated CRM metrics/knowledge candidate tools. Not registered into analytics-workbench or competition.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node build.mjs",
    "test:host": "node --test test/host.integration.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@deepseek-ai/cordis": "4.0.2"
  },
  "exports": {
    ".": "./lib/index.js",
    "./host": "./lib/host.js",
    "./graph-tools": "./lib/graph-tools.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-renderer"]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
