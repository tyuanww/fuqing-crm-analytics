{
  "name": "@shine-mage/dsh-crm-knowledge",
  "version": "0.0.0-crm.1",
  "private": true,
  "type": "module",
  "description": "CRM dashboard, metrics and private analysis assets; knowledge tools are a separately installed optional plugin.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node build.mjs",
    "test:host": "node --test test/host.integration.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/cordis": "4.0.2"
  },
  "exports": {
    ".": "./lib/index.js",
    "./host": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/host.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "pnpm@11.7.0",
  "shinemage": {
    "plugin_domain": "crm",
    "composition_contract": "crm-knowledge-split/v1"
  }
}
