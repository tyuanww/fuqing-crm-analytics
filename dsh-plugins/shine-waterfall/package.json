{
  "name": "@shine-mage/dsh-shine-waterfall",
  "version": "0.0.0-b0",
  "private": true,
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": "24.x"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  },
  "type": "module",
  "description": "Shine Mage WATERFALL board kind: catalog offer, geometry, and 422 unknown-unit contract. Uninstall independently of the workbench.",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./waterfall": {
      "types": "./lib/waterfall.d.mts",
      "import": "./lib/waterfall.mjs",
      "default": "./lib/waterfall.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/waterfall.mjs",
    "cordis.patch.yml",
    "lib/waterfall.d.mts",
    "bundled-dependencies.json"
  ],
  "dsh": {
    "client": { "platform": "web" },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test src/waterfall.test.mjs src/client-lifecycle.test.mjs"
  },
  "devDependencies": {
    "@shine-mage/dsh-plugin-kit": "0.1.0",
    "@shine-mage/board-components": "0.1.0"
  }
}
