# Copy to /etc/shinemage/crm.env and chmod 600. Replace every placeholder.
HEALTH_API_KEY=REPLACE_WITH_RANDOM_SECRET
FQ_CRM_ADMINS=REPLACE_WITH_ADMIN_USERNAME
FQ_CRM_PASSWORDS=REPLACE_WITH_USERNAME_PASSWORD_PAIRS
DUCKDB_PATH=/app/data/processed/fuqing_crm.duckdb
FQ_DB_MODE=production
FQ_RFM_PREWARM=0
UVICORN_WORKERS=1

# The state directory is inside the persistent CRM data mount.
FQ_CRM_ANALYSIS_STATE_DIR=/app/data/state/analytics
FQ_CRM_GRAPH_ACL_FILE=/app/data/state/graph-acl.json
