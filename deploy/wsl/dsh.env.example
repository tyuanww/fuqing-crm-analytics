# Copy to /etc/shinemage/dsh.env and chmod 600. Keep values on the server.
DSH_REPO=/srv/shinemage/dsh/current
DSH_UPSTREAM=/srv/shinemage/dsh/upstream-0.2.1-rc.3
DSH_RUNTIME=/srv/shinemage/dsh/runtime
DSH_NODE=/usr/local/lib/node-v24.21.0-linux-x64/bin/node
NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
# Internal listener stays loopback; this is the browser-visible API origin.
PAGE_DOCUMENTS_BROWSER_BASE=https://page.tyuan.chat
PAGE_RESULT_BROWSER_BASE=https://page.tyuan.chat
