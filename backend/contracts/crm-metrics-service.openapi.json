{
  "openapi": "3.1.0",
  "info": {
    "title": "CRM metrics v1 candidate",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/crm-metrics/capabilities": {
      "get": {
        "summary": "Capabilities",
        "operationId": "capabilities_api_v1_crm_metrics_capabilities_get",
        "parameters": [
          {
            "name": "X-ShineMage-Contract",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Exact public synthetic service API identity; not an authentication credential.",
              "const": "crm-metrics-service/1.0.0",
              "title": "X-Shinemage-Contract"
            },
            "description": "Exact public synthetic service API identity; not an authentication credential."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "Browser Origin rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "409": {
            "description": "Service API identity mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request; input details are not echoed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "400": {
            "description": "Metric contract or synthetic source rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/crm-metrics/query": {
      "post": {
        "summary": "Query",
        "operationId": "query_api_v1_crm_metrics_query_post",
        "parameters": [
          {
            "name": "X-ShineMage-Contract",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Exact public synthetic service API identity; not an authentication credential.",
              "const": "crm-metrics-service/1.0.0",
              "title": "X-Shinemage-Contract"
            },
            "description": "Exact public synthetic service API identity; not an authentication credential."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MetricRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricResult"
                }
              }
            }
          },
          "403": {
            "description": "Browser Origin rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "409": {
            "description": "Service API identity mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request; input details are not echoed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          },
          "400": {
            "description": "Metric contract or synthetic source rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Limitation": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "related_fact": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Related Fact"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "Limitation"
      },
      "MetricRequest": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "contains_real_data": {
            "type": "boolean",
            "title": "Contains Real Data"
          },
          "metric_version": {
            "type": "string",
            "const": "crm-metrics/v1",
            "title": "Metric Version"
          },
          "query_id": {
            "type": "string",
            "enum": [
              "sales_window_summary",
              "existing_customer_repurchase",
              "sample_followup"
            ],
            "title": "Query Id"
          },
          "period_start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "title": "Period Start"
          },
          "period_end_exclusive": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "title": "Period End Exclusive"
          },
          "refund_view": {
            "type": "string",
            "enum": [
              "ORDER_COHORT_AS_OF",
              "REFUND_FLOW"
            ],
            "title": "Refund View"
          },
          "refund_as_of": {
            "type": "string",
            "title": "Refund As Of"
          },
          "data_through": {
            "type": "string",
            "title": "Data Through"
          },
          "timezone": {
            "type": "string",
            "const": "Asia/Shanghai",
            "title": "Timezone",
            "default": "Asia/Shanghai"
          },
          "channel_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Channel Ids"
          },
          "product_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Ids"
          },
          "identity_scope": {
            "type": "string",
            "const": "STOREWIDE",
            "title": "Identity Scope",
            "default": "STOREWIDE"
          },
          "observation_days": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 365.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Observation Days"
          },
          "amount_already_net": {
            "type": "boolean",
            "title": "Amount Already Net",
            "default": false
          },
          "cohort_period_start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cohort Period Start"
          },
          "cohort_period_end_exclusive": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cohort Period End Exclusive"
          },
          "actor_scope": {
            "type": "string",
            "title": "Actor Scope",
            "default": "server_filled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "contains_real_data",
          "metric_version",
          "query_id",
          "period_start",
          "period_end_exclusive",
          "refund_view",
          "refund_as_of",
          "data_through"
        ],
        "title": "MetricRequest"
      },
      "MetricResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "OK",
              "UNAVAILABLE"
            ],
            "title": "Status"
          },
          "schema_version": {
            "type": "string",
            "const": "crm-metrics-wire/v1",
            "title": "Schema Version",
            "default": "crm-metrics-wire/v1"
          },
          "query_version": {
            "type": "string",
            "const": "crm-metrics-query/v1",
            "title": "Query Version",
            "default": "crm-metrics-query/v1"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "contains_real_data": {
            "type": "boolean",
            "title": "Contains Real Data"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic"
          },
          "metric_version": {
            "type": "string",
            "const": "crm-metrics/v1",
            "title": "Metric Version"
          },
          "query_id": {
            "type": "string",
            "title": "Query Id"
          },
          "metric_id": {
            "type": "string",
            "title": "Metric Id"
          },
          "data_version": {
            "type": "string",
            "title": "Data Version"
          },
          "mapping_version": {
            "type": "string",
            "title": "Mapping Version"
          },
          "data_through": {
            "type": "string",
            "title": "Data Through"
          },
          "resolved_filters": {
            "$ref": "#/components/schemas/ResolvedFilters"
          },
          "facts": {
            "additionalProperties": true,
            "type": "object",
            "title": "Facts"
          },
          "limitations": {
            "items": {
              "$ref": "#/components/schemas/Limitation"
            },
            "type": "array",
            "title": "Limitations"
          },
          "query_ref": {
            "type": "string",
            "title": "Query Ref"
          },
          "decision_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Decision Ids"
          },
          "implementation_status": {
            "type": "string",
            "enum": [
              "synthetic_verified",
              "not_implemented",
              "source_unverified"
            ],
            "title": "Implementation Status"
          },
          "publication_status": {
            "type": "string",
            "const": "local_isolated_candidate",
            "title": "Publication Status",
            "default": "local_isolated_candidate"
          },
          "real_business_acceptance": {
            "type": "boolean",
            "title": "Real Business Acceptance",
            "default": false
          },
          "production_release": {
            "type": "boolean",
            "title": "Production Release",
            "default": false
          },
          "adapter_query_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Adapter Query Ref"
          },
          "adapter_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Adapter Version"
          },
          "permission_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Permission Version"
          },
          "actor_scope": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor Scope"
          },
          "source_data_through": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Data Through"
          },
          "coverage_start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coverage Start"
          },
          "history_complete": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "History Complete"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "source_id",
          "contains_real_data",
          "synthetic",
          "metric_version",
          "query_id",
          "metric_id",
          "data_version",
          "mapping_version",
          "data_through",
          "resolved_filters",
          "facts",
          "limitations",
          "query_ref",
          "decision_ids",
          "implementation_status"
        ],
        "title": "MetricResult"
      },
      "ResolvedFilters": {
        "properties": {
          "period_start": {
            "type": "string",
            "title": "Period Start"
          },
          "period_end_exclusive": {
            "type": "string",
            "title": "Period End Exclusive"
          },
          "refund_view": {
            "type": "string",
            "title": "Refund View"
          },
          "refund_as_of": {
            "type": "string",
            "title": "Refund As Of"
          },
          "data_through": {
            "type": "string",
            "title": "Data Through"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "channel_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Channel Ids"
          },
          "product_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Ids"
          },
          "identity_scope": {
            "type": "string",
            "title": "Identity Scope"
          },
          "observation_days": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observation Days"
          },
          "amount_already_net": {
            "type": "boolean",
            "title": "Amount Already Net"
          },
          "cohort_period_start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cohort Period Start"
          },
          "cohort_period_end_exclusive": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cohort Period End Exclusive"
          },
          "yoy_period_start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Yoy Period Start"
          },
          "yoy_period_end_exclusive": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Yoy Period End Exclusive"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "period_start",
          "period_end_exclusive",
          "refund_view",
          "refund_as_of",
          "data_through",
          "timezone",
          "channel_ids",
          "product_ids",
          "identity_scope",
          "amount_already_net"
        ],
        "title": "ResolvedFilters"
      },
      "ServiceError": {
        "properties": {
          "status": {
            "type": "string",
            "const": "UNAVAILABLE",
            "title": "Status"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "code"
        ],
        "title": "ServiceError",
        "description": "Sanitized wire errors shared by the two public synthetic transports."
      }
    }
  }
}
